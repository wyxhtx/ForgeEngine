{
  "name": "ktx",
  "version-semver": "4.4.2",
  "description": [
    "The Khronos KTX library and tools.",
    "Functions for writing and reading KTX files, and instantiating OpenGL and Vulkan textures from them."
  ],
  "homepage": "https://github.com/KhronosGroup/KTX-Software",
  "license": "Apache-2.0",
  "supports": "arm64 | x64 | !windows",
  "dependencies": [
    "opengl-registry",
    { "name": "vcpkg-cmake", "host": true },
    { "name": "vcpkg-cmake-config", "host": true },
    "zstd"
  ],
  "features": {
    "tools": {
      "description": "Build tools",
      "supports": "!android & !uwp",
      "dependencies": [ "cxxopts", "fmt" ]
    },
    "vulkan": {
      "description": "Build Vulkan support",
      "supports": "!emscripten"
    }
  }
}