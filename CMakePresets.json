{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs",
      "displayName": "ForgeEngine VS2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_APPLOCAL_DEPS": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-forgeengine",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/config/vcpkg/triplet",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/config/vcpkg/port",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed"
      }
    },
    {
      "name": "ninja",
      "displayName": "ForgeEngine Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_APPLOCAL_DEPS": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-forgeengine",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/config/vcpkg/triplet",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/config/vcpkg/port",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "vs", "configuration": "Release" },
    { "name": "debug",   "configurePreset": "vs", "configuration": "Debug" },
    { "name": "ninja",   "configurePreset": "ninja" }
  ]
}